# New file: make_bagman_proms.sh, a bash port of make_bagman_proms.bat used by
# contrib/tools/user/roms.sh. Shipped as a patch so that make check reproduces it.
--- /dev/null
+++ b/vhdl_bagman_rev_0_1_2018_06_05/tools/bagman_unzip/make_bagman_proms.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+# Port of make_bagman_proms.bat for the Basys3 build. Run from this
+# directory (the unzipped bagman.zip) by contrib/tools/roms.sh, which sets:
+#   MAKE_VHDL_PROM  path of the compiled make_vhdl_prom
+#   PROM_DIR        output directory for the PROM VHDL
+# make_vhdl_prom names the entity after its output argument, so it runs inside
+# PROM_DIR with bare output file names.
+
+set -euo pipefail
+
+: "${MAKE_VHDL_PROM:?}" "${PROM_DIR:?}"
+roms="$(pwd)"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+
+cat e9_b05.bin f9_b06.bin f9_b07.bin k9_b08.bin m9_b09s.bin n9_b10.bin > "$tmp/prog.bin"
+cat p3.bin r3.bin > "$tmp/bagman_palette.bin"
+cat e1_b02.bin c1_b01.bin > "$tmp/bagman_tile0.bin"
+cat j1_b04.bin f1_b03s.bin > "$tmp/bagman_tile1.bin"
+
+cd "$PROM_DIR"
+"$MAKE_VHDL_PROM" "$tmp/prog.bin"           bagman_program.vhd
+"$MAKE_VHDL_PROM" "$tmp/bagman_tile0.bin"   bagman_tile_bit0.vhd
+"$MAKE_VHDL_PROM" "$tmp/bagman_tile1.bin"   bagman_tile_bit1.vhd
+"$MAKE_VHDL_PROM" "$tmp/bagman_palette.bin" bagman_palette.vhd
+"$MAKE_VHDL_PROM" "$roms/r9_b11.bin"        bagman_speech1.vhd
+"$MAKE_VHDL_PROM" "$roms/t9_b12.bin"        bagman_speech2.vhd
